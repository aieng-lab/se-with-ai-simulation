}

@misc{anthropic2026autonomy,
  author       = {McCain, Miles and Millar, Thomas and Huang, Saffron and Eaton, Jake and Handa, Kunal and Stern, Michael and Tamkin, Alex and Kearney, Matt and Durmus, Esin and Shen, Judy and Hong, Jerry and Calvert, Brian and Chan, Jun Shern and Mosconi, Francesco and Saunders, David and Neylon, Tyler and Nicholas, Gabriel and Pollack, Sarah and Clark, Jack and Ganguli, Deep},
  title        = {Measuring {AI} Agent Autonomy in Practice},
  year         = {2026},
  month        = feb,
  howpublished = {\url{https://www.anthropic.com/research/measuring-agent-autonomy}},
  note         = {Accessed 2026-07-21. Telemetry study of Claude Code sessions; reports human interventions per session falling from 5.4 to 3.3 (Aug--Dec), interruption rates of 5\% (novice) to 9\% (experienced) of turns, median turn duration $\sim$45\,s, and Claude Code itself proactively requesting clarification more often than users interrupt it, over 2$\times$ more frequently on highly complex tasks.}
}

@misc{baumann2026swechat,
  author       = {Baumann, Joachim and Padmakumar, Vishakh and Li, Xiang and Yang, John and Yang, Diyi and Koyejo, Sanmi},
  title        = {{SWE-chat}: Coding Agent Interactions From Real Users in the Wild},
  year         = {2026},
  howpublished = {\url{https://arxiv.org/abs/2604.20779}},
  note         = {Accessed 2026-07-21. Analysis of 6{,}000 real-world coding-agent sessions (63{,}000+ user prompts, 355{,}000+ agent tool calls); reports hard user interruptions in 3.3--6.0\% of turns and agent-initiated clarification requests in only 1.1--2.6\% of turns, with median turn duration under one minute.}
}

@misc{squarespace2019rfc,
  author       = {{Squarespace Engineering}},
  title        = {The Power of ``Yes, if'': Iterating on our {RFC} Process},
  year         = {2019},
  howpublished = {\url{https://engineering.squarespace.com/blog/2019/the-power-of-yes-if}},
  note         = {Accessed 2026-07-21. Describes a dedicated Architecture Review track giving each major RFC a full one-hour review session (with reviewers expected to have read the proposal beforehand), created after a faster Infrastructure Council track ($\sim$20\,min/RFC) proved too rushed for thorough review.}
}

@article{maranzano2005architecture,
  author  = {Maranzano, Joseph F. and Rozsypal, Sandra A. and Zimmerman, Gus H. and Warnken, Guy W. and Wirth, Patricia E. and Weiss, David M.},
  title   = {Architecture Reviews: Practice and Experience},
  journal = {IEEE Software},
  volume  = {22},
  number  = {2},
  pages   = {34--43},
  year    = {2005},
  doi     = {10.1109/MS.2005.28},
  note    = {Formal, heavyweight architecture reviews across AT\&T, Avaya, and Lucent (700+ reviews since 1988): review-packet preparation can take up to six weeks, with the review meeting itself spanning one to five days.}
}

@misc{zimmermann2023adrreview,
