  howpublished = {\url{https://ozimmer.ch/practices/2023/04/05/ADRReview.html}},
  note         = {Accessed 2026-07-21. Recommends a lightweight ADR ``readout'' review meeting of 30--45 minutes total, opening with 10--15 minutes of silent individual reading, with fewer than 10 attendees.}
}

@misc{he2026cursordebt,
  author       = {He, Hao and Miller, Courtney and Agarwal, Shyam and K{\"a}stner, Christian and Vasilescu, Bogdan},
  title        = {Speed at the Cost of Quality: How {Cursor AI} Increases Short-Term Velocity and Long-Term Complexity in Open-Source Projects},
  year         = {2026},
  howpublished = {\url{https://arxiv.org/abs/2511.04427}},
  note         = {Accessed 2026-07-21. To appear at MSR'26. Difference-in-differences study of 806 GitHub repositories adopting Cursor (vs.\ 1{,}380 matched controls), Jan.\ 2024--Aug.\ 2025. Reports post-adoption increases in SonarQube static-analysis warnings (+30.3\%) and cognitive complexity (+41.6\%), and, via a dynamic-panel GMM model, that a 100\% increase in complexity is associated with a 64.5\% decrease and a 100\% increase in static-analysis warnings with a 50.3\% decrease in subsequent lines added; a $\sim$3--5$\times$ increase in debt indicators fully cancels Cursor's velocity gains.}
}

@inproceedings{ohira2015highimpact,
  author    = {Ohira, Masao and Kashiwa, Yutaro and Yamatani, Yosuke and Yoshiyuki, Hayato and Maeda, Yoshiya and Limsettho, Nachai and Fujino, Keisuke and Hata, Hideaki and Ihara, Akinori and Matsumoto, Kenichi},
  title     = {A Dataset of High Impact Bugs: Manually-Classified Issue Reports},
  booktitle = {2015 IEEE/ACM 12th Working Conference on Mining Software Repositories (MSR)},
  pages     = {518--521},
  year      = {2015},
  doi       = {10.1109/MSR.2015.78},
  note      = {Manually classified 4{,}000 JIRA issue reports across four Apache projects (Ambari, Camel, Derby, Wicket) into six non-exclusive high-impact-bug types, including Security, cross-tabulated against issue priority (Table IV). Notes that priority/severity tags in issue trackers are often unreliable, clustering at middle (``Major'') levels.}
}

@inproceedings{iacob2013mobileapps,
  author    = {Iacob, Claudia and Harrison, Rachel},
  title     = {Retrieving and Analyzing Mobile Apps Feature Requests from Online Reviews},
  booktitle = {2013 10th IEEE Working Conference on Mining Software Repositories (MSR)},
  pages     = {41--44},
  year      = {2013},
  doi       = {10.1109/MSR.2013.6624001},
  note      = {Mined a sample of mobile app store reviews and found that 23.3\% constitute feature requests (users suggesting new features or redesigns of existing ones), indicating that feature requests are a substantial, measurable share of user-generated software demand.}
}

@misc{kc2025featurerequests,
  author       = {K C, Pragyan and Ghandiparsi, Rambod and Herron, Thomas and Heaps, John and Hosseini, Mitra Bokaei},
  title        = {Demystifying Feature Requests: Leveraging {LLMs} to Refine Feature Requests in Open-Source Software},
  year         = {2025},
  howpublished = {\url{https://arxiv.org/abs/2507.13555}},
  note         = {Accessed 2026-07-22. To appear at the 33rd IEEE International Requirements Engineering Conference (RE 2025). Manually-curated dataset of 476 feature-request issues from two long-running open-source GitHub repositories: 414 from \texttt{signalapp/Signal-Android} (created 2011-12-15) and 62 from \texttt{mastodon/mastodon-android} (created 2022-01-14); reports average submission-to-completion turnaround of 599 and 254 days, respectively. Normalising each project's count by its repository lifetime (repo creation dates verified via the GitHub API, not stated in the source paper) gives a pooled rate of $\approx$0.5 feature requests per project per week.}
}

@article{dzidek2008uml,
  author  = {Dzidek, Wojciech J. and Arisholm, Erik and Briand, Lionel C.},
  title   = {A Realistic Empirical Evaluation of the Costs and Benefits of {UML} in Software Maintenance},
  journal = {IEEE Transactions on Software Engineering},
  volume  = {34},
  number  = {3},
  pages   = {407--432},
  year    = {2008},
  doi     = {10.1109/TSE.2008.15},
  note    = {Controlled experiment with professional developers maintaining an industrial system with vs.\ without {UML} documentation. Reports a 54\% increase in functional correctness of changes (p=0.03) but only a non-significant 14\% increase in development time (p=0.35) attributable to keeping the documentation updated -- i.e.\ no reliable time-savings benefit was found, only a correctness benefit.}
}

@article{abdelsalam2026comments,
  author  = {Abdelsalam, Yasser and Peitek, Norman and Bergum, Annabelle and Apel, Sven},
  title   = {The Effect of Comments on Program Comprehension: An Eye-Tracking Study},
  journal = {Empirical Software Engineering},
  year    = {2026},
  doi     = {10.1007/s10664-025-10721-2},
  note    = {Eye-tracking experiment (20 subjects, 12 Java snippets with/without comments) measuring comprehension correctness and response time. Reports that comments' effect on comprehension-performance measures ranges from a 30\% decrease to a 34\% increase depending on the snippet, i.e.\ a non-monotonic effect; comments guided visual attention (up to 23\% of fixations) but favourable perception of comments did not consistently translate into improved performance.}
}

@misc{chatlatanagulchai2025agentreadmes,
  author       = {Chatlatanagulchai, Warit and Li, Haoyang and Kashiwa, Yutaro and Reid, Brittany and Thonglek, Kundjanasith and Leelaprute, Pattara and Rungsawang, Arnon and Manaskasemsak, Bundit and Adams, Bram and Hassan, Ahmed E. and Iida, Hajimu},
  title        = {Agent {READMEs}: An Empirical Study of Context Files for Agentic Coding},
  year         = {2025},
  howpublished = {\url{https://arxiv.org/abs/2511.12884}},
  note         = {Accessed 2026-07-22. Mining study of 2{,}303 agent context files (e.g.\ {AGENTS.md}) across 1{,}925 repositories using Claude Code, Codex, and Copilot. Finds developers prioritise functional content (build/run commands 62.3\%, implementation details 69.9\%, architecture 67.7\%) over security/performance guidance (14.5\% each); does not measure any quantitative effect of context-file quality on agent task success or human supervision burden.}
}

@misc{coderabbit2025aicode,
